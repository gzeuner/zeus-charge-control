# Copy to config/application.properties before starting the distribution.
# This template contains only supported settings. Keep tokens and local IPs private.

# Web UI. Localhost is safest; choose a deliberate LAN/reverse-proxy binding if needed.
server.address=${SERVER_ADDRESS:0.0.0.0}
server.port=${SERVER_PORT:8080}
spring.h2.console.enabled=false
spring.thymeleaf.cache=true

# Persistent H2 storage, relative to the extracted package.
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:h2:file:./data/zeus-charge-control;DB_CLOSE_ON_EXIT=FALSE}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:sa}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:password}
spring.jpa.hibernate.ddl-auto=update

# Sonnen API v2. Enter the local base URL (for example http://<BATTERY_IP>/api/v2) and token.
battery.url=${BATTERY_URL:}
battery.authToken=${BATTERY_AUTH_TOKEN:}
battery.time-zone=${BATTERY_TIME_ZONE:Europe/Berlin}
battery.inverter.max.watts=${BATTERY_INVERTER_MAX_WATTS:4600}
battery.grid.import.limit.watts=${BATTERY_GRID_IMPORT_LIMIT_WATTS:4600}
# Match module count and usable module capacity to the installed battery.
battery.capacity.installed-modules=${BATTERY_INSTALLED_MODULES:2}
battery.capacity.module-usable-capacity-wh=${BATTERY_MODULE_USABLE_CAPACITY_WH:5000}
# Seasonal targets are examples; tune them to your reserve and usage.
battery.season.winter.start-month=${BATTERY_WINTER_START_MONTH:11}
battery.season.winter.end-month=${BATTERY_WINTER_END_MONTH:2}
battery.season.winter.target-state-of-charge=${BATTERY_WINTER_TARGET_SOC:90}
battery.season.summer.start-month=${BATTERY_SUMMER_START_MONTH:3}
battery.season.summer.end-month=${BATTERY_SUMMER_END_MONTH:10}
battery.season.summer.target-state-of-charge=${BATTERY_SUMMER_TARGET_SOC:70}
battery.status.cache.duration.seconds=${BATTERY_STATUS_CACHE_SECONDS:10}
battery.config.cache.duration.seconds=${BATTERY_CONFIG_CACHE_SECONDS:300}
battery.history.max.entries=${BATTERY_HISTORY_MAX_ENTRIES:24}
battery.automatic.mode.check.interval=${BATTERY_MODE_CHECK_INTERVAL_MS:60000}
battery.pv.only.enabled=${BATTERY_PV_ONLY_ENABLED:true}
battery.hold.interval.seconds=${BATTERY_HOLD_INTERVAL_SECONDS:15}
battery.manual.hold.ms=${BATTERY_MANUAL_HOLD_MS:900000}
battery.manual.idle.hold.ms=${BATTERY_MANUAL_IDLE_HOLD_MS:900000}
battery.schedule.hold.ms=${BATTERY_SCHEDULE_HOLD_MS:600000}
battery.night.pause.watts=${BATTERY_NIGHT_PAUSE_WATTS:1}
battery.nightChargingIdle=${BATTERY_NIGHT_CHARGING_IDLE:false}
battery.handback.debounce.ms=${BATTERY_HANDBACK_DEBOUNCE_MS:60000}
battery.setpoint.refresh.ms=${BATTERY_SETPOINT_REFRESH_MS:0}
battery.night.state.path=${BATTERY_NIGHT_STATE_PATH:./data/night-idle.state}
battery.rsoc.min.floor=${BATTERY_RSOC_MIN_FLOOR:15}
battery.rsoc.drop.default.per.hour=${BATTERY_RSOC_DROP_DEFAULT_PER_HOUR:3.0}

# Market-price refresh and provider. Tibber needs a token; Awattar remains the fallback.
scheduled.job.cron=${SCHEDULED_JOB_CRON:0 15 14,22,2 * * *}
battery.accepted.delay=${BATTERY_ACCEPTED_DELAY_MINUTES:30}
marketdata.source=${MARKETDATA_SOURCE:awattar}
marketdata.print=${MARKETDATA_PRINT:false}
awattar.marketdata.url=${AWATTAR_MARKETDATA_URL:https://api.awattar.de/v1/marketdata}
awattar.authToken=${AWATTAR_AUTH_TOKEN:}
tibber.marketdata.url=${TIBBER_MARKETDATA_URL:https://api.tibber.com/v1-beta/gql}
tibber.authToken=${TIBBER_AUTH_TOKEN:}

# Charging-plan behavior. Adjust these only if you want to tune the planner.
scheduling.wait.min.savings.ct=${SCHEDULING_WAIT_MIN_SAVINGS_CT:1.0}
scheduling.wait.min.savings.pct=${SCHEDULING_WAIT_MIN_SAVINGS_PCT:0.05}
scheduling.wait.max.delay.minutes=${SCHEDULING_WAIT_MAX_DELAY_MINUTES:120}
scheduling.wait.max.defer.hours=${SCHEDULING_WAIT_MAX_DEFER_HOURS:6}
scheduling.wait.min.price.diff.cents=${SCHEDULING_WAIT_MIN_PRICE_DIFF_CENTS:0.5}
scheduling.wait.relative.drop.pct=${SCHEDULING_WAIT_RELATIVE_DROP_PCT:5}
scheduling.night.latestStart.offset.minutes=${SCHEDULING_NIGHT_LATEST_START_OFFSET_MINUTES:60}
scheduling.daytime.lookahead.hours=${SCHEDULING_DAYTIME_LOOKAHEAD_HOURS:12}
nighttime.max.periods=${NIGHTTIME_MAX_PERIODS:2}
scheduling.catchup.enabled=${SCHEDULING_CATCHUP_ENABLED:true}
scheduling.catchup.rsoc.drop.pct=${SCHEDULING_CATCHUP_RSOC_DROP_PCT:5}
scheduling.catchup.max.minutes.from.start=${SCHEDULING_CATCHUP_MAX_MINUTES_FROM_START:90}
scheduling.addition.score.alpha.ct.per.min=${SCHEDULING_ADDITION_SCORE_ALPHA_CT_PER_MIN:0.02}
scheduling.addition.small.max.extra.ct=${SCHEDULING_ADDITION_SMALL_MAX_EXTRA_CT:0.5}
scheduling.addition.small.need.kwh=${SCHEDULING_ADDITION_SMALL_NEED_KWH:0.5}
scheduling.grid-guard.mode=${SCHEDULING_GRID_GUARD_MODE:ACTIVE}
# Set actual site values to enable forecast-based grid-target preview; zero disables that preview.
scheduling.preview.pv-kwp=${SCHEDULING_PREVIEW_PV_KWP:0}
scheduling.preview.household-watts=${SCHEDULING_PREVIEW_HOUSEHOLD_WATTS:0}

# Weather-aware charging uses the public Open-Meteo API; no API token is required.
# Enter both numeric coordinates, then enable the feature.
weather.api.enabled=${WEATHER_API_ENABLED:false}
weather.api.base-url=${WEATHER_API_BASE_URL:https://api.open-meteo.com/v1/forecast}
# weather.api.latitude=YOUR_LATITUDE
# weather.api.longitude=YOUR_LONGITUDE
weather.api.hourly-params=${WEATHER_API_HOURLY_PARAMS:cloudcover}
weather.sunny-threshold=${WEATHER_SUNNY_THRESHOLD_PERCENT:40}
weather.lookahead.hours=${WEATHER_LOOKAHEAD_HOURS:12}
weather.wait.max.minutes=${WEATHER_WAIT_MAX_MINUTES:120}
weather.wait.min.rsoc=${WEATHER_WAIT_MIN_RSOC:45}

# Wallbox Modbus control. Fill in the IP and set WALLBOX_ENABLED=true only when ready to control it.
wallbox.enabled=${WALLBOX_ENABLED:false}
wallbox.host=${WALLBOX_HOST:<WALLBOX_IP>}
wallbox.port=${WALLBOX_PORT:502}
wallbox.unit-id=${WALLBOX_UNIT_ID:1}
wallbox.mode=${WALLBOX_MODE:ECO}
wallbox.poll-interval-ms=${WALLBOX_POLL_INTERVAL_MS:8000}
wallbox.connect-timeout-ms=${WALLBOX_CONNECT_TIMEOUT_MS:2000}
wallbox.read-timeout-ms=${WALLBOX_READ_TIMEOUT_MS:2500}
wallbox.max-errors-before-reconnect=${WALLBOX_MAX_ERRORS_BEFORE_RECONNECT:3}
wallbox.consumption-includes-wallbox=${WALLBOX_CONSUMPTION_INCLUDES_WALLBOX:true}
wallbox.smart-min-usoc=${WALLBOX_SMART_MIN_USOC:20}
wallbox.smart-reserve-percent=${WALLBOX_SMART_RESERVE_PERCENT:5}
wallbox.resume-hold-seconds=${WALLBOX_RESUME_HOLD_SECONDS:16}
wallbox.config-file=${WALLBOX_CONFIG_FILE:./config/application.properties}

# KOSTAL PLENTICORE / PIKO IQ read-only Modbus TCP. Fill in the IP before enabling.
kostal.enabled=${KOSTAL_ENABLED:false}
kostal.host=${KOSTAL_HOST:<INVERTER_IP>}
kostal.port=${KOSTAL_PORT:1502}
kostal.unit-id=${KOSTAL_UNIT_ID:71}
kostal.byte-order=${KOSTAL_BYTE_ORDER:CDAB}
kostal.poll-interval-ms=${KOSTAL_POLL_INTERVAL_MS:5000}
kostal.connect-timeout-ms=${KOSTAL_CONNECT_TIMEOUT_MS:2000}
kostal.read-timeout-ms=${KOSTAL_READ_TIMEOUT_MS:3000}
kostal.read-powermeter=${KOSTAL_READ_POWERMETER:false}
kostal.read-battery=${KOSTAL_READ_BATTERY:false}
kostal.read-dc-power=${KOSTAL_READ_DC_POWER:true}
kostal.max-pv-power-w=${KOSTAL_MAX_PV_POWER_W:30000}
# Use fresh KOSTAL PV readings in surplus control; stale/unavailable KOSTAL data falls back to Sonnen.
kostal.pv-source=${KOSTAL_PV_SOURCE:KOSTAL}

# Local quiet hours. Align these with your tariff and routine.
night.start=${NIGHT_START:19}
night.end=${NIGHT_END:6}

# Display-only tariff estimate. Replace defaults with your own contract charges.
price.display.vat-rate=${PRICE_DISPLAY_VAT_RATE:0.19}
price.display.surcharges.procurement=${PRICE_DISPLAY_PROCUREMENT:1.81}
price.display.surcharges.grid=${PRICE_DISPLAY_GRID:7.58}
price.display.surcharges.concession=${PRICE_DISPLAY_CONCESSION:1.59}
price.display.surcharges.electricity-tax=${PRICE_DISPLAY_ELECTRICITY_TAX:2.05}
price.display.surcharges.offshore=${PRICE_DISPLAY_OFFSHORE:0.941}
price.display.surcharges.kwk=${PRICE_DISPLAY_KWK:0.446}
price.display.surcharges.stromnev19=${PRICE_DISPLAY_STROMNEV19:1.56}

# Rotating logs use the current Spring Boot property names.
logging.file.name=${LOGGING_FILE_NAME:logs/power.log}
logging.level.root=${LOGGING_LEVEL_ROOT:INFO}
logging.logback.rollingpolicy.max-file-size=${LOGGING_FILE_MAX_SIZE:10MB}
logging.logback.rollingpolicy.max-history=${LOGGING_FILE_MAX_HISTORY:10}
logging.logback.rollingpolicy.total-size-cap=${LOGGING_FILE_TOTAL_SIZE_CAP:100MB}
